<UserControl x:Class="LogEOT.UI.Views.DownloadLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="15"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="SFTP Logs Download"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Servers:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                    <StackPanel x:Name="ServerPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="Server20CheckBox" Content="192.168.240.20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="Server21CheckBox" Content="192.168.240.21" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <Button x:Name="AddServerButton" Content="+" Width="28" Height="24" Padding="0" FontSize="16" FontWeight="Bold" Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="AddServer_Click" ToolTip="Add a server address (this session only)"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output Dir:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox x:Name="OutputDirBox" Grid.Column="1" MinHeight="36" Margin="0,0,10,0" Tag="Enter output folder..." VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse" MinHeight="36" Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Browse_Click"/>
                </Grid>

                <Border Height="1" Background="#E2E8F0" Margin="0,15,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/> 
                        <ColumnDefinition Width="*"/>   
                        <ColumnDefinition Width="60"/> 
                        <ColumnDefinition Width="80"/> 
                        <ColumnDefinition Width="*"/>  
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ModelLabel" Grid.Row="0" Grid.Column="0" Text="Model (*):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox x:Name="ModelTextBox" Grid.Row="0" Grid.Column="1" MinHeight="36" Tag="Enter Model..." VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="MO:" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                    <TextBox x:Name="MoTextBox" Grid.Row="0" Grid.Column="4" MinHeight="36" Tag="Enter MO..." VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Date:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                    <DatePicker x:Name="StartDatePicker" Grid.Row="2" Grid.Column="1" MinHeight="36" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="End Date:" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                    <DatePicker x:Name="EndDatePicker" Grid.Row="2" Grid.Column="4" MinHeight="36" VerticalContentAlignment="Center"/>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Logs Include:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="PassCheckBox" Content="PASS Logs" Margin="0,0,15,0"/>
                            <CheckBox x:Name="FailCheckBox" Content="FAIL Logs" Margin="0,0,15,0"/>
                            <CheckBox x:Name="KeepRootFolderCheckBox" Content="Keep root folder" Margin="0,0,15,0"/>
                            <CheckBox x:Name="ListMacCheckBox" Content="List MAC" Margin="0,0,15,0" Checked="ListMacCheckBox_Checked" Unchecked="ListMacCheckBox_Unchecked"/>
                            <CheckBox x:Name="RemoveDuplicateCheckBox" Content="Remove duplicate log pass"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MacFilePanel" Margin="0,15,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MAC List:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="MacFileBox" Grid.Column="1" MinHeight="36" Margin="0,0,10,0" Tag="Select MAC List file (.txt)..." IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Browse" MinHeight="36" Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BrowseMac_Click"/>
                    </Grid>
                </StackPanel>
                
                <Button x:Name="DownloadButton" Content="Start Download" Width="180" Height="40" Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Download_Click" HorizontalAlignment="Center" Margin="0,10,0,12"/>

                <Border x:Name="BusyStatusBorder"
                        Visibility="Collapsed"
                        Background="#E8F3FF"
                        BorderBrush="#60A5FA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="BusyStatusText"
                                   Text="Đang tìm kiếm logs, vui lòng chờ..."
                                   FontWeight="SemiBold"
                                   Foreground="#075985"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <ProgressBar Height="6"
                                     IsIndeterminate="True"
                                     Background="#BFDBFE"
                                     Foreground="#0284C7"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Progress:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                    <ProgressBar x:Name="DownloadProgress" Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="0" Background="#E2E8F0" Foreground="#0067C0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <TextBlock x:Name="ProgressText" Grid.Column="2" Margin="15,0,0,0" Text="0/0" VerticalAlignment="Center" Foreground="#64748B" Width="100" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
