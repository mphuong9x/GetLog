<UserControl x:Class="LogEOT.UI.Views.AnalyzeLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="15"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Log Folder:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FolderTextBox"
                         Grid.Column="1"
                         Height="36"
                         Margin="0,0,10,0"
                         Tag="Select Logs Folder..."/>

                <Button Grid.Column="2"
                        Content="Browse"
                        Width="100"
                        Height="36"
                        Background="#0067C0" 
                        Foreground="White"
                        BorderBrush="#0067C0"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Browse_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <CheckBox x:Name="AudioLogsCheckBox" Content="Audio Logs" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Search Box"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>
            </Grid>

            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding Keys}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enable"
                                            Binding="{Binding Enabled}"
                                            Width="80">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="Search Key (in log)"
                                        Binding="{Binding Key}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Alt Search Key (in log)"
                                        Binding="{Binding AltKey}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Column Name (in Excel)"
                                        Binding="{Binding ColumnName}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <Button Grid.Row="4" Content="Run" Width="180" Height="40" Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Run_Click" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </Grid>
    </Border>
</UserControl>
