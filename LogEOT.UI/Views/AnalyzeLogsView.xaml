<UserControl x:Class="LogEOT.UI.Views.AnalyzeLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="15"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Log Folder:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FolderTextBox"
                         Grid.Column="1"
                         Height="36"
                         Margin="0,0,10,0"
                         Tag="Select Logs Folder..."/>

                <Button Grid.Column="2"
                        Content="Browse"
                        Width="100"
                        Height="36"
                        Click="Browse_Click"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">
                <TextBlock Text="Log Type:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,16,0"/>
                <RadioButton x:Name="PassLogsRadioButton"
                             Content="PASS Logs"
                             GroupName="AnalyzeLogType"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0"/>
                <RadioButton x:Name="FailLogsRadioButton"
                             Content="FAIL Logs"
                             GroupName="AnalyzeLogType"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0"/>
                <RadioButton x:Name="AllLogsRadioButton"
                             Content="ALL Logs"
                             GroupName="AnalyzeLogType"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search Box"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>
                <Button x:Name="SaveKeysButton" Grid.Column="1" Content="Save Keys"
                        MinWidth="110" Height="36" Margin="12,0,10,0" Click="SaveKeys_Click"/>
                <Button x:Name="LoadConfigButton" Grid.Column="2" Content="Load Keys"
                        MinWidth="110" Height="36" Click="LoadConfig_Click"/>
                <Button x:Name="ResetKeysButton" Grid.Column="3" Content="Reset Keys"
                        MinWidth="110"
                        Height="36"
                        Click="Reset_Click"
                        Margin="10,0,0,0"/>
            </Grid>

            <DataGrid x:Name="KeysGrid" Grid.Row="3"
                      ItemsSource="{Binding Keys}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#64748B"
                      VerticalGridLinesBrush="#64748B"
                      BorderBrush="#475569"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Search Key (in log)"
                                        Binding="{Binding Key}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Alt Search Key (in log)"
                                        Binding="{Binding AltKey}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Column Name (in Excel)"
                                        Binding="{Binding ColumnName}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0">
                <Button Content="Run"
                        Width="180"
                        Height="40"
                        Click="Run_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
